# Copy this file to .env and adjust values:   copy .env.example .env   (Windows)
#                                              cp .env.example .env     (Linux/macOS)
# Never commit .env. Real environment variables override values in .env.

# --- Application -----------------------------------------------------------
# development | testing | production
APP_ENV=development
# Required in production (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty in development/testing, a random key is generated at startup.
SECRET_KEY=

# --- Flask / Socket.IO ---------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# "threading" is the Windows-compatible choice.
SOCKETIO_ASYNC_MODE=threading
# Optional message queue for emitting events from worker processes (later module).
SOCKETIO_MESSAGE_QUEUE=
# Comma-separated list; defaults to the Flask host/port.
SOCKETIO_CORS_ALLOWED_ORIGINS=

# --- Apache Kafka --------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=smart-building
KAFKA_CONSUMER_GROUP_PREFIX=smart-building
# Prepended to every topic name (testing defaults to "test.").
KAFKA_TOPIC_PREFIX=
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# earliest | latest
KAFKA_AUTO_OFFSET_RESET=earliest
# 0 | 1 | all
KAFKA_PRODUCER_ACKS=all
KAFKA_REQUEST_TIMEOUT_MS=10000

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# The testing environment appends "_test" to this name.
POSTGRES_DB=smart_building
POSTGRES_USER=smart_building
POSTGRES_PASSWORD=change_me
# disable | allow | prefer | require | verify-ca | verify-full
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5

# --- Logging ---------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL (default depends on APP_ENV)
LOG_LEVEL=
# json | text
LOG_FORMAT=json
LOG_DIR=logs
LOG_TO_FILE=true
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
