# Copy this file to .env and adjust values:   copy .env.example .env   (Windows)
#                                              cp .env.example .env     (Linux/macOS)
# Never commit .env. Real environment variables override values in .env.

# --- Application -----------------------------------------------------------
# development | testing | production
APP_ENV=development
# Required in production (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty in development/testing, a random key is generated at startup.
SECRET_KEY=

# --- Flask / Socket.IO ---------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# "threading" is the Windows-compatible choice.
SOCKETIO_ASYNC_MODE=threading
# Optional message queue for emitting events from worker processes (later module).
SOCKETIO_MESSAGE_QUEUE=
# Comma-separated list; defaults to the Flask host/port.
SOCKETIO_CORS_ALLOWED_ORIGINS=

# --- Apache Kafka --------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=smart-building
KAFKA_CONSUMER_GROUP_PREFIX=smart-building
# Prepended to every topic name (testing defaults to "test.").
KAFKA_TOPIC_PREFIX=
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# earliest | latest
KAFKA_AUTO_OFFSET_RESET=earliest
# 0 | 1 | all
KAFKA_PRODUCER_ACKS=all
KAFKA_REQUEST_TIMEOUT_MS=10000
# How long the producer retries a message (e.g. during a broker restart) before failing it.
KAFKA_MESSAGE_TIMEOUT_MS=120000
# Reconnection back-off after a broker disconnect (grows up to the max).
KAFKA_RECONNECT_BACKOFF_MS=500
KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
# 1 for the local single-broker setup.
KAFKA_REPLICATION_FACTOR=1

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# The testing environment appends "_test" to this name.
POSTGRES_DB=smart_building
POSTGRES_USER=smart_building
POSTGRES_PASSWORD=change_me
# disable | allow | prefer | require | verify-ca | verify-full
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5

# --- Building simulator ----------------------------------------------------------
SIM_BUILDING_ID=building-01
# Wall-clock seconds between readings (1-5).
SIM_INTERVAL_SECONDS=2
# Simulated seconds per real second (1 = real time, 60 = 1 min per second, max 3600).
SIM_SPEED_FACTOR=1
# Simulated start time (ISO 8601). Empty = now.
SIM_START_TIME=
# Integer seed for reproducible runs. Empty = random.
SIM_RANDOM_SEED=
SIM_PHYSICS_STEP_SECONDS=60
# Building location/time zone, used for sun position and schedules.
SIM_LATITUDE=40.0
SIM_UTC_OFFSET_HOURS=0
# Synthetic outdoor climate (used until the weather API module is added).
SIM_OUTDOOR_ANNUAL_MEAN_C=15
SIM_OUTDOOR_SEASONAL_AMPLITUDE_C=10
SIM_OUTDOOR_DIURNAL_AMPLITUDE_C=5

# --- External data: weather and carbon intensity --------------------------------
# Building location (used for weather and, unless a zone is set, carbon intensity).
BUILDING_LATITUDE=40.42
BUILDING_LONGITUDE=-3.70
# open-meteo | mock   (mock = synthetic data labelled source="mock", for offline work)
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Only needed for Open-Meteo's commercial API (set the matching base URL too).
OPEN_METEO_API_KEY=
WEATHER_POLL_INTERVAL_S=900
WEATHER_FORECAST_HOURS=24
# electricitymaps | uk-carbon-intensity | mock
#   electricitymaps      needs ELECTRICITY_MAPS_API_KEY (free key: https://portal.electricitymaps.com)
#   uk-carbon-intensity  no key, Great Britain only (api.carbonintensity.org.uk)
CARBON_PROVIDER=electricitymaps
ELECTRICITY_MAPS_API_KEY=
ELECTRICITY_MAPS_BASE_URL=https://api.electricitymaps.com/v3
# Optional zone code (e.g. ES, DE, IN-WE); empty = derive from latitude/longitude.
ELECTRICITY_MAPS_ZONE=
CARBON_POLL_INTERVAL_S=900
# Response cache (survives restarts; never contains API keys).
EXTERNAL_DATA_CACHE_DIR=data/cache
HTTP_TIMEOUT_S=10
HTTP_MAX_RETRIES=3

# --- HVAC / lighting optimizer (deterministic, SciPy) ------------------------------
OPT_SETPOINT_MIN_C=16
OPT_SETPOINT_MAX_C=28
# Comfort band while a zone is occupied, and the allowed setback band when empty.
OPT_COMFORT_MIN_C=20
OPT_COMFORT_MAX_C=25
OPT_COMFORT_NEUTRAL_C=1.0
OPT_SETBACK_MIN_C=17
OPT_SETBACK_MAX_C=27
# Empty but within (or 1 h before) operating hours: comfort band widened by this margin.
OPT_STANDBY_MARGIN_C=1.5
OPT_PRECONDITIONING_LEAD_S=3600
# The room temperature swings +/- this around the setpoint; setpoints keep this distance
# from the comfort/equipment limits so the *temperature* stays inside them.
OPT_THERMOSTAT_DEADBAND_C=0.5
OPT_MAX_SETPOINT_STEP_C=1.5
# Simulated seconds between decisions for each zone.
OPT_DECISION_INTERVAL_S=900
# Objective weights (cost units per kWh, per kg CO2e, per occupant*K^2*h of discomfort).
OPT_ENERGY_WEIGHT_PER_KWH=0.15
OPT_CARBON_WEIGHT_PER_KG=0.10
OPT_COMFORT_WEIGHT=0.5

# --- Agentic AI (LangGraph incident agent) ---------------------------------------
# auto | anthropic | offline. "auto" uses Claude when ANTHROPIC_API_KEY is set and
# otherwise the deterministic offline policy (labelled "offline" in all records).
AGENT_LLM_PROVIDER=auto
# Keep the key secret: it is read from the environment only and never logged.
ANTHROPIC_API_KEY=
AGENT_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AGENT_LLM_EFFORT=high
AGENT_LLM_MAX_TOKENS=16000
AGENT_LLM_TIMEOUT_S=120
# Re-run a request on a fallback model if the primary model declines it.
AGENT_LLM_REFUSAL_FALLBACK=true
AGENT_MAX_ITERATIONS=10
# low | medium | high | critical: alerts below this are not investigated.
AGENT_MIN_ALERT_SEVERITY=medium
AGENT_INCIDENT_COOLDOWN_S=3600
# An investigation that took no action is re-checked after this long if alerts continue.
AGENT_UNCONFIRMED_RECHECK_S=900
AGENT_MAX_ACTIONS_PER_ZONE_PER_HOUR=4
AGENT_MAX_DATA_AGE_S=1800
AGENT_MAX_ISOLATED_SENSORS_PER_ZONE=2
AGENT_AUDIT_LOG=logs/agent_decisions.jsonl

# --- Dashboard ---------------------------------------------------------------------
# Seconds between live-update polls of PostgreSQL (Socket.IO push to browsers).
DASHBOARD_POLL_INTERVAL_S=2
# Start/stop/attack buttons (default: on, except APP_ENV=production).
DASHBOARD_CONTROLS_ENABLED=
DASHBOARD_COMPARISON_RESULTS=docs/results/optimization_comparison.json

# --- Logging ---------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL (default depends on APP_ENV)
LOG_LEVEL=
# json | text
LOG_FORMAT=json
LOG_DIR=logs
LOG_TO_FILE=true
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
